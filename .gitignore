# Secrets: real env files never enter git — only templates do
# (.env.example placeholders, .env.nas = CI-rendered placeholder template).
.env
.env.*
!.env.example
!.env.nas
# IaC placeholder templates (NAS_* placeholders, no secret values)
!.env.munni-iac-*
**/env/.env
**/env/.env.*
!**/env/.env.example
!**/env/.env.nas
# Android upload keystore (lives in repo secrets + this local copy)
*.keystore
bin/
obj/
**/coverage/
*.scratch.test.ts

