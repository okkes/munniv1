<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press launcher shortcuts (§5). The VIEW intents ride the same
     munni:// deep-link path the webview already parses; the dev flavor
     overrides this file with its own package/scheme. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="review"
        android:enabled="true"
        android:shortcutShortLabel="@string/shortcut_review">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="munni://review"
            android:targetPackage="app.munni"
            android:targetClass="app.munni.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="transactions"
        android:enabled="true"
        android:shortcutShortLabel="@string/shortcut_transactions">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="munni://transactions"
            android:targetPackage="app.munni"
            android:targetClass="app.munni.MainActivity" />
    </shortcut>
</shortcuts>
