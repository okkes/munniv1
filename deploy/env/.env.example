# Template — copy to .env.local and fill in. Real values never enter git.

# --- domains / registry -------------------------------------------------
DOMAIN=okkes.synology.me
# images are published to GHCR by GitHub Actions
REGISTRY=ghcr.io/okkes
TAG=latest
# GitHub username + fine-grained PAT with read:packages only.
# update.sh re-logs-in from these on every run (reboot/upgrade-proof).
GHCR_USER=okkes
GHCR_PAT=

# --- postgres (shared instance: munni + logto + glitchtip databases) -----
POSTGRES_PASSWORD=

# --- logto ----------------------------------------------------------------
# API resource indicator configured in the Logto admin console
LOGTO_API_RESOURCE=https://munni-api.okkes.synology.me

# --- glitchtip -------------------------------------------------------------
# python -c "import secrets; print(secrets.token_hex(32))"
GLITCHTIP_SECRET_KEY=
# optional smtp url, e.g. smtp://user:pass@mail:587 (defaults to console)
GLITCHTIP_EMAIL_URL=
API_SENTRY_DSN=

# --- gocardless bank account data (bankaccountdata.gocardless.com) --------
GOCARDLESS_SECRET_ID=
GOCARDLESS_SECRET_KEY=

# --- admin ------------------------------------------------------------------
# comma-separated OIDC subs allowed into the in-app admin area.
# find yours: Logto console -> Users -> your user -> ID, or /me in the app.
ADMIN_SUBS=

# --- pgadmin (database inspector; keep the proxy LAN-only) -----------------
PGADMIN_EMAIL=admin@okkes.synology.me
PGADMIN_PASSWORD=

# --- backups ---------------------------------------------------------------
# NAS path picked up by Hyper Backup
BACKUP_DIR=/volume1/backups/munni

# --- web push (generate once: npx web-push generate-vapid-keys) -----------
# use a SEPARATE pair per environment; replacing a pair silently kills
# that environment's existing subscriptions
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=mailto:admin@okkes.synology.me

# --- native app push (Firebase console -> project settings -> service
# accounts -> generate key). Paste the whole JSON file as ONE line.
# Optional — without it native devices simply receive no pushes yet.
FCM_SERVICE_ACCOUNT_JSON=

# --- logo.dev brand search (logo.dev dashboard -> API keys) ----------------
# secret key stays server-side (search proxy); publishable token is baked
# into the image URLs the API returns. Optional — the vendored simpleicons
# set keeps working without it.
LOGODEV_SECRET_KEY=
LOGODEV_PUBLIC_TOKEN=

# ── watch-folder importer (optional) ─────────────────────────────────
# Drop CAMT.053 exports (manual downloads or a personal scraper's
# output) into the host folder and the api ingests them as raw bank
# feeds for this user — same deterministic ids as device imports and
# GoCardless, so everything dedupes. Empty sub = feature off.
IMPORT_WATCH_OWNER_SUB=
IMPORT_WATCH_HOST_DIR=./import-watch

# ── Enable Banking (optional second bank-data provider) ──────────────
# Free for personal use: register an application at enablebanking.com,
# download its private key. The admin console picks which provider
# serves NEW bank consents; existing accounts keep their provider.
ENABLEBANKING_APPLICATION_ID=
# the full PEM, newlines escaped as \n or the compose-file multiline form
ENABLEBANKING_PRIVATE_KEY_PEM=
