<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <!-- GHSA-v5pm-xwqc-g5wc flags every OpenApi 2.x, but the fixed 3.x
         line breaks AspNetCore.OpenApi's source generator (built against
         2.x, incl. 10.0.10). The vulnerable path is PARSING untrusted
         OpenAPI documents; this api only GENERATES its own document.
         Pinned to the newest 2.x, suppressed until Microsoft ships a
         3.x-compatible generator — dependabot will surface that bump. -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.11.0" NoWarn="NU1903" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.16.17" />
    <PackageReference Include="Sentry.AspNetCore" Version="6.8.0" />
    <PackageReference Include="WebPush" Version="1.0.13" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="GoCardless\keyword-rules.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- test seams (GcFetchService.FetchAllAsync etc.) -->
    <InternalsVisibleTo Include="Munni.Api.Tests" />
  </ItemGroup>

</Project>
